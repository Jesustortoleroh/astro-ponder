---
// Frontmatter
// This code runs on the server, NOT sent to the browser.
const title = "Home";
const message = "¡Hello Astro!";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro | {title}</title>
  </head>
  <body>
    <h1>{message}</h1>
    <p>My first Astro page!</p>
    <p>I am learning how to build websites with Astro!</p>
  </body>
</html>
