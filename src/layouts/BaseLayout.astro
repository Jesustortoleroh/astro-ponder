---
// Frontmatter: Code that runs on the server, NOT sent to the browser.
import Header from "../components/Header.astro";
const { title = "Astro" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro | {title}</title>
  </head>
  <body>
    <header>
      <h1>Astro</h1>
      <Header />
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5em 0;
    border-bottom: 1px solid #ccc;
    margin-bottom: 1em;
  }
  header h1 {
    margin: 0;
  }
</style>